# Environment variables for the portfolio backend
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (read-only, public repos is enough)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=JONATHAN-DEV-01

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Email (optional — if not set, contact form uses mailto:)
RESEND_API_KEY=
FROM_EMAIL=contato@jonathannascimento.dev
TO_EMAIL=jonathanads2006@gmail.com

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub sync interval in hours (0 = disabled, use manual /api/sync)
SYNC_INTERVAL_HOURS=6
